# ============================================
# Base de donnees MySQL
# ============================================
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=NBAFanFinder
MYSQL_USER=nbafanfinder_app
MYSQL_PASSWORD=changeme_app_password

# ============================================
# Backend Spring Boot - connexion BDD
# ============================================
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/NBAFanFinder
SPRING_DATASOURCE_USERNAME=nbafanfinder_app
SPRING_DATASOURCE_PASSWORD=changeme_app_password

# Mode Hibernate : validate (prod), update (dev), create-drop (tests)
SPRING_JPA_DDL_AUTO=update

# ============================================
# Securite - JWT
# ============================================
# Generer une chaine aleatoire d'au moins 64 caracteres
JWT_SECRET=changeme_generate_a_long_random_secret
JWT_EXPIRATION=86400000

# ============================================
# CORS - origines autorisees (jamais '*')
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ============================================
# Cookie d'authentification
# ============================================
# true UNIQUEMENT en prod (HTTPS requis)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# ============================================
# Frontend (Vite) - URL de l'API
# ============================================
VITE_API_URL=/api
